(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow file-read*)
(deny file-write* (subpath (param "ERS05_MAINFRAME_ROOT")))
(deny file-write* (subpath (param "ERS05_APPARATUS_ROOT")))
(deny file-write* (subpath (param "ERS05_APPARATUS_WORKBENCH")))
(deny file-write* (subpath (param "ERS05_PR148_ROOT")))
(deny file-write* (subpath (param "ERS05_PR149_ROOT")))
(deny file-write* (subpath (param "ERS05_CONTROL_ROOT")))
(deny file-write* (subpath (param "ERS05_FROZEN_CHECKOUTS_ROOT")))
(deny file-write* (subpath (param "ERS05_FIXTURES_ROOT")))
(deny file-write* (subpath (param "ERS05_SCIENTIFIC_SANDBOX")))
(deny file-write* (subpath (param "ERS05_RUNTIME_ROOT")))
(deny file-write* (subpath (param "ERS05_CANARY_ROOT")))
(allow file-write* (subpath (param "ERS05_ALLOWED_OUTPUT")))
(allow file-write* (subpath (param "ERS05_ALLOWED_TEMP")))
(allow sysctl-read)
(allow mach-lookup)
(deny network*)
